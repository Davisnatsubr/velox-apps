<?xml version="1.0" encoding="utf-8"?>
<!-- As listas IPTV costumam usar HTTP: libera conexões sem HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
